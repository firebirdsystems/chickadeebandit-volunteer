{
  "id": "volunteer",
  "name": "Volunteer Sign-Up",
  "version": "1.0.0",
  "description": "SignUpGenius-style slot sheets for potlucks, classroom helpers, carpool coverage, or shift backfills. Members claim, swap, and release capacity-limited slots without overbooking.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["signup", "volunteer", "slots", "events", "slot-claims"],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": ["capacity", "note", "event_date"],
  "row_policies": {
    "sheets": {
      "kind": "adult_writable",
      "steward_writes_only": true
    },
    "slots": {
      "kind": "adult_writable",
      "steward_writes_only": true
    },
    "slot_claims": {
      "kind": "endpoint_only",
      "read": "everyone"
    }
  },
  "slot_claims": {
    "slot_table": "slots",
    "capacity_column": "capacity",
    "slot_status_column": "status",
    "slot_open_values": ["open"],
    "claims_table": "slot_claims",
    "slot_fk_column": "slot_id",
    "member_column": "member_id",
    "created_at_column": "created_at",
    "one_claim_per_member": true,
    "allow_release": true,
    "allowed_columns": ["note"],
    "max_text_lengths": { "note": 200 }
  },
  "automation_actions": {
    "create_sheet": {
      "title": "Open a sign-up sheet",
      "description": "Open a sheet with its first slot when another app records something that needs helpers — a potluck, a game day, a work party. Members claim the slot the normal way; capacity is still enforced by the hub's claim endpoint.",
      "params": {
        "title": { "type": "text", "label": "Sheet title", "required": true },
        "event_date": { "type": "text", "label": "Date (yyyy-mm-dd)", "required": true },
        "location": { "type": "text", "label": "Location", "default": "" },
        "slot_title": { "type": "text", "label": "First slot", "default": "Volunteers" },
        "capacity": { "type": "integer", "label": "How many people", "default": 1, "min": 1 }
      },
      "dedupe": { "table": "sheets", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "sheets",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "location": ":location",
            "event_date": ":event_date",
            "created_by": "automation",
            "created_by_name": "Automation",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        },
        {
          "op": "lookup",
          "table": "sheets",
          "where": { "source_event_id": "$event_id" },
          "bind": { "sheet_id": "id" },
          "on_missing": "error"
        },
        {
          "op": "insert",
          "table": "slots",
          "values": {
            "id": "$uuid",
            "sheet_id": ":sheet_id",
            "title": ":slot_title",
            "capacity": ":capacity",
            "created_at": "$now"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Open a sign-up sheet when an event goes on the calendar",
      "description": "A new calendar event opens a sheet dated the same day, so the ask for helpers exists from the moment the event does rather than a week later when someone remembers.",
      "trigger_event": "calendar.event_created",
      "target_app_id": "volunteer",
      "action_id": "create_sheet",
      "param_map": {
        "title": { "kind": "payload_field", "value": "title" },
        "event_date": { "kind": "payload_field", "value": "start_date" },
        "slot_title": { "kind": "const", "value": "Help set up" },
        "capacity": { "kind": "const", "value": 2 }
      }
    }
  ],
  "publishes": ["volunteer.sheet_created", "volunteer.slot_claimed"],
  "member_references": {
    "sheets": { "column": "created_by", "on_removed": "keep" },
    "slot_claims": { "column": "member_id", "on_removed": "delete" }
  },
  "nav": { "label": "Volunteer" },
  "agenda": {
    "kind": "event",
    "label": "Volunteer",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, NULLIF(location, '') AS subtitle, event_date AS when_at FROM app_volunteer__sheets WHERE event_date = :today AND archived = 0 ORDER BY created_at LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, NULLIF(location, '') AS subtitle, event_date AS at FROM app_volunteer__sheets WHERE archived = 0 AND event_date >= :today ORDER BY event_date LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "subtitle": "subtitle", "when": "at" }
  },
  "widget": { "label": "Volunteer", "size": "small" },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🙋",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_slots", "signup_summary"]
  }
}
